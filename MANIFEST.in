include README.md LICENSE.txt NOTICE.md PROVENANCE.md CITATION.cff CHANGELOG.md
include Makefile requirements-dev.txt ruff.toml .coveragerc
exclude requirements-dev.lock
recursive-include docs *.md
recursive-include .github *.md *.yml
exclude .github/CODE_OF_CONDUCT.md
recursive-include evidence *.md *.json
recursive-include examples *.py
recursive-include tools *.py
recursive-include tests *.py
recursive-include fuzz *.py *.json *.md
recursive-include lean *.lean *.toml *.json *.txt *.md *.py .gitattributes lean-toolchain
prune lean/.lake
prune lean/.verification
prune lean/verification/d1-law-*
global-exclude __pycache__ *.py[cod] *.olean *.ilean
